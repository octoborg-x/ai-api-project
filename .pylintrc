[MASTER]
# Add the current directory and the specific week directory to the path
# so Pylint can find 'chunker'
init-hook="import sys; sys.path.append('.'); sys.path.append('./week2/day2')"

[BASIC]
# Allow snake_case for constants (module-level variables)
# This fixes: Constant name "document" doesn't conform to UPPER_CASE naming style
const-naming-style=snake_case
const-rgx=[a-z_][a-z0-9_]{2,30}$
